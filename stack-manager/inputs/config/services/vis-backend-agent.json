{
    "ServiceSpec": {
      "Name": "vis-backend-agent",
      "TaskTemplate": {
        "ContainerSpec": {
          "Image": "ghcr.io/theworldavatar/vis-backend-agent:1.5.1-snapshot",
          "Env": [
            "NAMESPACE=mpp",
            "TASKS_ENABLED=false"
          ],
          "Mounts": [
            {
              "Type": "volume",
              "Source": "vis-backend",
              "Target": "/usr/local/tomcat/resources"
            }
          ],
          "Configs": [
            {
              "ConfigName": "blazegraph"
            }
          ],
          "Secrets": [
            {
              "SecretName": "blazegraph_password"
            }
          ]
        }
      }
    },
    "endpoints": {
      "ui": {
        "url": "http://localhost:8080/vis-backend-agent/",
        "externalPath": "/vis-backend-agent/"
      }
    }
  }